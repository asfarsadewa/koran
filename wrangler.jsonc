{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juara-merdeka",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "koran.r3ptil.com",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juara-merdeka",
      "migrations_dir": "./migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEKs2UwMS-hZSiQ5",
    "ACCESS_TTL_SECONDS": "43200"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
