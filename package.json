{
  "name": "juara-merdeka",
  "version": "0.1.0",
  "private": true,
  "description": "An Eve-curated Indonesian and Chinese world-news broadsheet published on Cloudflare Workers.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:agent": "eve dev --no-ui",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "agent:info": "eve info",
    "agent:build": "eve build",
    "agent:curate": "eve invoke \"Susun dan terbitkan edisi harian Juara Merdeka sekarang sesuai tata kerja redaksi.\"",
    "agent:curate:kemarin": "eve invoke \"Susun dan terbitkan lembar Kemarin Juara Merdeka sekarang sesuai tata kerja redaksi historis.\"",
    "worker:dry-run": "wrangler deploy --dry-run",
    "build": "npm run typecheck && npm run test:coverage && npm run agent:info && npm run agent:build && npm run worker:dry-run",
    "deploy:worker": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply juara-merdeka --local",
    "d1:migrate:remote": "wrangler d1 migrations apply juara-merdeka --remote",
    "d1:seed:local": "wrangler d1 execute juara-merdeka --local --file fixtures/demo.sql"
  },
  "keywords": [
    "eve",
    "cloudflare-workers",
    "d1",
    "newspaper"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "ai": "^7.0.58",
    "eve": "^0.31.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "just-bash": "^3.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
